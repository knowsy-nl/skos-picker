{
  "name": "@taxonomy/skos-picker",
  "version": "1.0.0",
  "description": "Framework-agnostic SKOS taxonomy picker — a vanilla <skos-picker> custom element plus a matching React <SkosPicker> component.",
  "type": "module",
  "license": "MIT",
  "author": "Jeroen Steggink (knowsy)",
  "packageManager": "pnpm@9.12.0",
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.test.jsx",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./web-component": {
      "types": "./src/web-component/skos-picker.d.ts",
      "default": "./src/web-component/skos-picker.js"
    },
    "./react": {
      "types": "./src/react/SkosPicker.d.ts",
      "default": "./src/react/SkosPicker.jsx"
    },
    "./react/styles.css": "./src/react/skos-picker.css",
    "./angular": "./src/adapters/angular/skos-picker.directive.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": ">=0.5",
    "@angular/core": ">=16",
    "@angular/forms": ">=16"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "lucide-react": { "optional": true },
    "@angular/core": { "optional": true },
    "@angular/forms": { "optional": true }
  },
  "devDependencies": {
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^5.1.1",
    "happy-dom": "^15.11.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.0",
    "vite": "^7.2.4",
    "vitest": "^2.1.0"
  }
}
