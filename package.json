{
  "name": "@knowsy/skos-picker",
  "version": "1.0.0",
  "description": "Framework-agnostic SKOS taxonomy picker — a vanilla <skos-picker> custom element plus a matching React <SkosPicker> component.",
  "type": "module",
  "license": "MIT",
  "author": "Jeroen Steggink (knowsy)",
  "homepage": "https://github.com/knowsy-nl/skos-picker#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowsy-nl/skos-picker.git"
  },
  "bugs": {
    "url": "https://github.com/knowsy-nl/skos-picker/issues"
  },
  "keywords": [
    "skos",
    "skos-xl",
    "taxonomy",
    "web-component",
    "custom-element",
    "picker",
    "select",
    "combobox",
    "react",
    "i18n"
  ],
  "packageManager": "pnpm@9.12.0",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "./src/web-component/skos-picker.js"
  ],
  "files": [
    "src",
    "!src/**/*.test.js",
    "!src/**/*.test.jsx",
    "!src/**/*.test.ts",
    "dist/angular",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/web-component/skos-picker.d.ts",
      "default": "./src/web-component/skos-picker.js"
    },
    "./web-component": {
      "types": "./src/web-component/skos-picker.d.ts",
      "default": "./src/web-component/skos-picker.js"
    },
    "./react": {
      "types": "./src/react/SkosPicker.d.ts",
      "default": "./src/react/SkosPicker.jsx"
    },
    "./react/styles.css": "./src/react/skos-picker.css",
    "./angular": {
      "types": "./dist/angular/skos-picker.directive.d.ts",
      "default": "./dist/angular/skos-picker.directive.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:angular": "tsc -p tsconfig.angular.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm test && pnpm run build:angular"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "lucide-react": ">=0.5",
    "@angular/core": ">=16",
    "@angular/forms": ">=16"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "happy-dom": "^15.11.0",
    "prettier": "^3.3.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rxjs": "^7.8.0",
    "typescript": "^5.6.0",
    "vite": "^7.2.4",
    "vitest": "^2.1.0"
  }
}
